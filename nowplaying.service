[Unit]
Description=Now-playing bridge (MPRIS to Telegram)
After=graphical-session.target dbus.socket
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/nowplaying/.venv/bin/python %h/nowplaying/nowplaying.py
WorkingDirectory=%h/nowplaying
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
